    "# 这一格做两件事：\n",
    "#   1. 从当前目录往上找，找到含 minif/ 的那一层，加进 sys.path\n",
    "#      —— 这样不管你在 notebooks/ 还是仓库根启动 Jupyter，import minif 都能成\n",
    "#   2. minif.plotting.setup() 统一所有图的字体、配色、网格\n",
    "import sys, pathlib\n",
    "ROOT = pathlib.Path.cwd()\n",
    "while not (ROOT / \"minif\").is_dir() and ROOT != ROOT.parent:\n",
    "    ROOT = ROOT.parent\n",
    "sys.path.insert(0, str(ROOT))\n",
    "print(\"仓库根：\", ROOT)\n",
    "\n",
    "from minif.plotting import setup\n",
    "plt = setup()"
   ]
  },
  {
