   "source": [
    "# 载入数据，并读出第 1 关的成绩当作今天的门槛。\n",
    "#   data.load(MOL, \"train\") 读 datasets/rna.npz，返回一个 list，\n",
    "#   每个元素是一条 RNA 链的 dict：\n",
    "#     coords  [L,4,3]  四个骨架原子 P / C4' / C1' / 糖苷N 的坐标\n",
    "#     seq     字符串   真实序列，也就是标准答案\n",
    "#     partner [L]      配对表，-1 表示不配对\n",
    "#     chi     [L,2,3]  只给 chi 用的两个额外原子：O4' 和碱基环上的 C4(嘌呤)/C2(嘧啶)\n",
    "#   scoreboard.read() 读仓库根的 progress.json\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "from minif import data, features as F, scoreboard\n",
    "from minif.plotting import tidy\n",
    "\n",
    "MOL = \"rna\"\n",
    "tr = data.load(MOL, \"train\"); va = data.load(MOL, \"val\")\n",
    "data.describe(tr, \"训练集：\"); data.describe(va, \"验证集：\")\n",
    "prev = scoreboard.read()[\"levels\"].get(\"1\", {}).get(\"recovery\")\n",
    "print(\"第 1 关成绩 %.1f%%，今天要超过 %.1f%%\" % (100*prev, 100*(prev+0.015)) if prev else \"（第 1 关还没记成绩）\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "91083a9f",
   "metadata": {},
   "source": [
    "## 部分 1 · 三个扭转角是什么，为什么用它们\n",
    "\n",
    "### eta / theta —— Duarte & Pyle 的赝扭转角\n",
    "\n",
    "RNA 主链有 6 个真扭转角（alpha 到 zeta），维度高又彼此相关，不好用。\n",
    "Duarte 和 Pyle 提出用两个**赝**扭转角概括，只需要 P 和 C4' 两种原子：\n",
    "\n",
    "```\n",
    "eta(i)   = C4'(i-1) - P(i)   - C4'(i)  - P(i+1)\n",
    "theta(i) = P(i)     - C4'(i) - P(i+1)  - C4'(i+1)\n",
    "```\n",
    "\n",
    "相邻两个角共享三个原子，像履带一样沿链滚动。\n",
    "\n",
    "> Duarte CM, Pyle AM. *Stepping through an RNA structure: a novel approach to\n",
    "> conformational analysis.* J Mol Biol. 1998;284(5):1465-1478.\n",
    "\n",
    "### chi —— 标准糖苷扭转角，不是赝角\n",
    "\n",
    "```\n",
    "嘌呤 (A, G)：O4' - C1' - N9 - C4\n",
    "嘧啶 (C, U)：O4' - C1' - N1 - C2\n",
    "```\n",
    "\n",
    "描述碱基相对**糖环平面**的朝向。syn 是 chi 落在 [-90°, +90°]，其余为 anti。\n",
    "**嘌呤取 syn 的比例明显高于嘧啶**，所以这是三个角里唯一直接带碱基身份信息的。\n",
    "\n",
    "⚠️ 也正因为如此，它的第四个原子（C4 / C2）在**碱基环上** ——\n",
    "要先知道是嘌呤还是嘧啶才能去取，而那正是要预测的答案。**部分 4 第三张表专门查这件事。**\n",
    "\n",
    "### 这一关要亲眼看到的两件事\n",
    "\n",
    "1. eta-theta 平面上 A 型螺旋聚成很紧的一团\n",
    "2. chi 绝大多数落在 anti 区 —— 这是验证 chi 算对了的判据\n",
    "\n",
    "对照文献：Grille et al. (2023) *The pseudotorsional space of RNA*,\n",
    "RNA 29(12):1896-1909（开放获取）。Figure 2 是 eta-theta 散点，\n",
    "**Figure 7 按碱基种类分开统计**。\n",
    "其他的扭转角定义方式（全套 alpha–zeta、糖环假旋转、eta'/theta'、eta''/theta''、\n",
    "RNA suite、以及干脆不用角的 ProteinMPNN / gRNAde）见 `notes/level2.md` 的对比表。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "834aaff2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "有效核苷酸 19586 个\n",
      "eta 中位数 168°   theta 中位数 215°\n"
     ]
    }
   ],
   "source": [
    "# 把训练集所有链的三个扭转角算出来，拼成一张大表 ang [总残基数, 6]。\n",
    "#\n",
    "# F.torsions_rna 返回的 6 列顺序是：\n",
    "#     sin(eta)  sin(theta)  sin(chi)  cos(eta)  cos(theta)  cos(chi)\n",
    "# 是「sin sin sin / cos cos cos」，不是交替 —— 取列的时候这里最容易弄错。\n",
    "#\n",
    "# arctan2(sin, cos) 把两列还原成角度；% 360 映射到 0~360，方便画图。\n",
    "# 缺原子 / 链头链尾的位置在特征里被填了 0，还原出来也是 0，用 ok 掩码剔掉。\n",
    "import numpy as np\n",
    "ang = np.concatenate([F.torsions_rna(r[\"coords\"], r.get(\"chi\")) for r in tr])\n",
    "eta = np.degrees(np.arctan2(ang[:, 0], ang[:, 3])) % 360\n",
    "theta = np.degrees(np.arctan2(ang[:, 1], ang[:, 4])) % 360\n",
    "ok = (eta > 0) & (theta > 0)\n",
    "print(\"有效核苷酸 %d 个\" % ok.sum())\n",
    "print(\"eta 中位数 %.0f°   theta 中位数 %.0f°\" % (np.median(eta[ok]), np.median(theta[ok])))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "8f73cf86",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 682x616 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# 画 eta-theta 散点。用 hexbin 而不是 scatter —— 几万个点画散点会糊成一片黑。\n",
    "# 要看到的：颜色最深的那一团就是 A 型螺旋区。\n",
    "# RNA 的构象自由度其实很受限，大部分核苷酸挤在很小一块区域里。\n",
    "# 这正是「能从几何反推序列」的前提：如果构象完全自由，几何就不带信息了。\n",
    "from minif.plotting import seq_cmap\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.rcParams[\"font.family\"] = \"PingFang SC\"\n",
    "plt.rcParams[\"axes.unicode_minus\"] = False\n",
    "fig, ax = plt.subplots(figsize=(6.2, 5.6))\n",
    "hb = ax.hexbin(eta[ok], theta[ok], gridsize=46, cmap=seq_cmap(), mincnt=1, linewidths=0)\n",
    "ax.set_xlabel(\"eta （度）\"); ax.set_ylabel(\"theta （度）\")\n",
    "ax.set_title(\"A 型螺旋聚成一团\")\n",
    "ax.set_xlim(0, 360); ax.set_ylim(0, 360)\n",
    "cb = fig.colorbar(hb, ax=ax, shrink=.85); cb.set_label(\"核苷酸数\", fontsize=13)\n",
    "cb.outline.set_visible(False)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "01309f9e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "有效核苷酸 20171 个（总共 20176）\n",
      "anti 区（|chi| > 90°）占 95.9%\n",
      "syn  区占 4.1%\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 814x418 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "嘌呤 A/G  n= 11155   syn 比例 6.3%\n",
      "嘧啶 C/U  n=  9016   syn 比例 1.4%\n"
     ]
    }
   ],
   "source": [
    "# 验证 chi 算对了没有。\n",
    "# 判据：结构化 RNA 以 anti 构象为主（|chi| > 90°），syn 很少。\n",
    "# 如果 syn 占了一大半，说明四个原子的顺序搞错了 —— 必须停下来查，别往下走。\n",
    "# 第二段按嘌呤 / 嘧啶分开：已知嘌呤取 syn 的比例更高，能重现就说明定义对了。\n",
    "#\n",
    "# 【这一格修过一个 bug】chi 和 seqs 必须用同一个掩码 m 过滤，长度才对得上。\n",
    "# 旧版用 seqs[:len(chi)] 截断，那是错的 —— 过滤会打乱位置对应关系，\n",
    "# 算出来的嘌呤/嘧啶比例不可信。如果你之前记过这两个数，用这一格的新结果覆盖。\n",
    "from minif.plotting import tidy, PALETTE\n",
    "\n",
    "ang = np.concatenate([F.torsions_rna(r[\"coords\"], r.get(\"chi\")) for r in tr])\n",
    "chi_all = np.degrees(np.arctan2(ang[:, 2], ang[:, 5]))\n",
    "seq_all = np.array(list(\"\".join(r[\"seq\"] for r in tr)))\n",
    "m = np.abs(chi_all) > 1e-9                 # 缺原子被填 0 的位置不算\n",
    "chi, seqs = chi_all[m], seq_all[m]         # 两个数组用同一个掩码，这是关键\n",
    "\n",
    "print(\"有效核苷酸 %d 个（总共 %d）\" % (len(chi), len(chi_all)))\n",
    "print(\"anti 区（|chi| > 90°）占 %.1f%%\" % (100*np.mean(np.abs(chi) > 90)))\n",
    "print(\"syn  区占 %.1f%%\" % (100*np.mean(np.abs(chi) <= 90)))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7.4, 3.8))\n",
    "ax.hist(chi, bins=72, range=(-180, 180), color=PALETTE[0])\n",
    "for x in (-90, 90):\n",
    "    ax.axvline(x, color=\"#52514e\", lw=1.2, ls=\"--\")\n",
    "top = ax.get_ylim()[1]*0.9\n",
    "for x, lab in [(0, \"syn\"), (-135, \"anti\"), (135, \"anti\")]:\n",
    "    ax.annotate(lab, (x, top), ha=\"center\", fontsize=13, color=\"#52514e\")\n",
    "ax.set_xlabel(\"chi （度）\"); ax.set_ylabel(\"核苷酸数\")\n",
    "ax.set_title(\"糖苷扭转角分布：应以 anti 为主\")\n",
    "ax.set_xticks([-180, -90, 0, 90, 180]); tidy(ax); plt.show()\n",
    "\n",
    "for grp, name in [(\"AG\", \"嘌呤 A/G\"), (\"CU\", \"嘧啶 C/U\")]:\n",
    "    sel = np.isin(seqs, list(grp))\n",
    "    if sel.sum():\n",
    "        print(\"%s  n=%6d   syn 比例 %.1f%%\" % (name, sel.sum(), 100*np.mean(np.abs(chi[sel]) <= 90)))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "72a9253c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "碱基    n      中位数    四分位距    syn 比例\n",
      "  A    5078    197.5°    19.6°       9.0%\n",
      "  C    4917    197.0°     9.6°       0.8%\n",
      "  G    6077    193.5°    15.0°       4.0%\n",
      "  U    4099    200.3°    14.5°       2.1%\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 836x440 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# 更细一步：anti 峰内部，四种碱基的 chi 分得开吗？这是 Grille 2023 Figure 7 的自制版。\n",
    "#\n",
    "# 为什么要 % 360：anti 区横跨 ±180，不映射的话这个峰会被边界劈成左右两半，\n",
    "# 中位数算出来会落在中间的空档里，完全没有意义。\n",
    "#\n",
    "# 怎么看结果：\n",
    "#   中位数那一列最直接 —— 四个数差几度是噪声，差十几度以上才算有信号。\n",
    "#   四条曲线基本重合 = chi 在 anti 区内不区分碱基，\n",
    "#   那第 2 关就只能靠那 5% 的 syn，大概率涨不动。那也是个结论，而且比硬凑诚实。\n",
    "ang = np.concatenate([F.torsions_rna(r[\"coords\"], r.get(\"chi\")) for r in tr])\n",
    "chi_all = np.degrees(np.arctan2(ang[:, 2], ang[:, 5]))\n",
    "seq_all = np.array(list(\"\".join(r[\"seq\"] for r in tr)))\n",
    "m = np.abs(chi_all) > 1e-9\n",
    "chi, seqs = chi_all[m] % 360, seq_all[m]    # 映射到 [0,360)，anti 合成一个峰\n",
    "\n",
    "print(\"碱基    n      中位数    四分位距    syn 比例\")\n",
    "for b in \"ACGU\":\n",
    "    v = chi[seqs == b]\n",
    "    q1, q2, q3 = np.percentile(v, [25, 50, 75])\n",
    "    syn = np.mean(~((v > 90) & (v < 270)))   # [0,360) 下 syn 是 0~90 和 270~360\n",
    "    print(\"  %s  %6d   %6.1f°   %5.1f°      %4.1f%%\" % (b, len(v), q2, q3-q1, 100*syn))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7.6, 4.0))\n",
    "for b, c in zip(\"ACGU\", list(PALETTE) + [\"#e34948\"]):\n",
    "    v = chi[seqs == b]\n",
    "    ax.hist(v, bins=90, range=(0, 360), histtype=\"step\", lw=2,\n",
    "            density=True, color=c, label=b)\n",
    "ax.set_xlabel(\"chi （度，映射到 0–360）\"); ax.set_ylabel(\"密度\")\n",
    "ax.set_title(\"anti 峰内部，四种碱基分得开吗\")\n",
    "ax.set_xlim(120, 260)          # 放大到 anti 区\n",
    "ax.legend(title=\"碱基\"); tidy(ax); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fe605819",
   "metadata": {},
   "source": [
    "## 部分 2 · 特征拼装：10 维\n",
    "\n",
    "| 列号 | 内容 | 来自 |\n",
    "|---|---|---|\n",
    "| 0, 1, 2 | sin(eta), sin(theta), sin(chi) | 第 2 关新增 |\n",
    "| 3, 4, 5 | cos(eta), cos(theta), cos(chi) | 第 2 关新增 |\n",
    "| 6, 7, 8 | 10 / 14 / 18 Å 半径内的邻居数 | 第 1 关 |\n",
    "| 9 | 配不配对（0 或 1） | 第 1 关 |\n",
    "\n",
    "3 个角 × 2 + 3 个邻居数 + 1 个配对 = **10**。\n",
    "\n",
    "**为什么拆 sin/cos**：角度是环形的，-179° 和 179° 其实挨着，\n",
    "直接喂数值会让模型以为它们差 358。拆成 (sin, cos) 之后两者挨得很近，环形关系就保住了。\n",
    "\n",
    "**一个没处理干净的坑**：算不出角的位置（链头链尾、缺原子、三点共线）统一补 0，\n",
    "拆完是 (0, 1) —— 和一个真实的 0° 角长得一模一样，模型分不出「没有」和「恰好是 0」。\n",
    "专业做法是再加一列 mask，这一版没加，记进第 7 关的差异清单。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "9c3fe948",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "一条链的点特征： (82, 10)   <- [L, 10]\n",
      "\n",
      "前 3 个核苷酸：\n",
      "        sin etasin theta  sin chi  cos etacos theta  cos chi    邻居10Å    邻居14Å    邻居18Å       配对\n",
      "   0      0.000    0.000    0.044    1.000    1.000   -0.999    0.100    0.200    1.000    1.000\n",
      "   1      0.237   -0.551   -0.042   -0.972   -0.835   -0.999    0.200    0.400    1.300    1.000\n",
      "   2      0.099   -0.645   -0.234   -0.995   -0.764   -0.972    0.200    0.600    1.400    1.000\n"
     ]
    }
   ],
   "source": [
    "# 看一条链的点特征长什么样，确认 shape 是 [L, 10]。\n",
    "# 对着列名看一眼数值范围：\n",
    "#   sin/cos 在 -1 ~ 1；邻居数已经除以 10 缩放过；配对是 0 或 1。\n",
    "# 量纲差太多会让训练不稳，所以邻居数那三列才要缩放。\n",
    "v = F.node_features(tr[0][\"coords\"], MOL, tr[0][\"partner\"], tr[0].get(\"chi\"))\n",
    "print(\"一条链的点特征：\", v.shape, \"  <- [L, 10]\")\n",
    "print()\n",
    "print(\"前 3 个核苷酸：\")\n",
    "cols = [\"sin eta\", \"sin theta\", \"sin chi\", \"cos eta\", \"cos theta\", \"cos chi\",\n",
    "        \"邻居10Å\", \"邻居14Å\", \"邻居18Å\", \"配对\"]\n",
    "print(\"      \" + \"\".join(\"%9s\" % c for c in cols))\n",
    "for i in range(3):\n",
    "    print(\"  %2d  \" % i + \"\".join(\"%9.3f\" % x for x in v[i]))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "c6c32fab",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "x (20176, 10)  y (20176,)\n"
     ]
    }
   ],
   "source": [
    "# 把所有链摊平成两张大表：\n",
    "#   xtr [总残基数, 10]  每行 = 一个残基的 10 个特征\n",
    "#   ytr [总残基数]      每行 = 这个残基的真实碱基（0=A 1=C 2=G 3=U）\n",
    "#\n",
    "# 注意：摊平之后链的边界就没了，每个残基都是一条独立样本，\n",
    "# 模型完全不知道谁和谁是邻居。第 1、2 关都是这样。\n",
    "# 残基之间传消息（kNN 图 + message passing）是第 3 关才有的东西。\n",
    "def flatten(recs):\n",
    "    xs = [F.node_features(r[\"coords\"], MOL, r[\"partner\"], r.get(\"chi\")) for r in recs]\n",
    "    ys = [F.seq_to_idx(r[\"seq\"], MOL) for r in recs]\n",
    "    return (torch.tensor(np.concatenate(xs), dtype=torch.float32),\n",
    "            torch.tensor(np.concatenate(ys), dtype=torch.long))\n",
    "\n",
    "xtr, ytr = flatten(tr); xva, yva = flatten(va)\n",
    "print(\"x\", tuple(xtr.shape), \" y\", tuple(ytr.shape))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dc4c96b7",
   "metadata": {},
   "source": [
    "## 部分 3 · 加非线性，训练，看过拟合\n",
    "\n",
    "`Linear → GELU → Linear → GELU → Linear`。**这就是「深度学习」里「深」的全部含义。**\n",
    "\n",
    "中间那层 128 个数叫**隐藏层**：既不是输入也不是输出，是模型自己造的中间指标。\n",
    "它的作用是让模型能表达「配对**并且** chi 在某个区间」这类组合条件 ——\n",
    "第 1 关的单个线性层做不到，只能给每个特征配一个权重然后相加。\n",
    "\n",
    "这次用小批量：一次只拿 512 个残基算梯度，比全量更新快也更稳。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "d4a8cede",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "参数量 18436\n",
      "最好 50.2%（第 21 轮）   最后一轮 48.4%\n"
     ]
    }
   ],
   "source": [
    "# 训练主模型。\n",
    "#\n",
    "# torch.manual_seed(0) —— 固定随机种子。模型初始权重是随机抽的，\n",
    "#   不固定的话今天 50.4、明天 49.8，分不清是不是自己改坏了什么。\n",
    "# H = 128 —— 隐藏层宽度，是下面那一格扫出来的结果，不是拍脑袋定的。\n",
    "#\n",
    "# 训练循环的五步（每一关都一样，背下来）：\n",
    "#   1 前向      model(x)        -> 每个残基 4 个分数（logits）\n",
    "#   2 算损失    CrossEntropyLoss = softmax 转概率 + 取真实类别的 -log(p)\n",
    "#   3 清梯度    opt.zero_grad()  <- 漏了这行梯度会累加，是最常见的 bug\n",
    "#   4 反向      loss.backward()  -> 算出每个参数该往哪个方向改\n",
    "#   5 更新      opt.step()       -> 真正改参数\n",
    "#\n",
    "# 每轮结束各评一次训练/验证恢复率，存进 hist 供画图。\n",
    "# best = 验证集最好的那一轮。注意这个数系统性偏乐观 1.5~2 个百分点\n",
    "#   （在 80 个抖动的数里挑最大值，自然挑到高处），部分 5 会说口径。\n",
    "torch.manual_seed(0)\n",
    "H = 128\n",
    "\n",
    "model = nn.Sequential(\n",
    "    nn.Linear(xtr.shape[1], H), nn.GELU(),\n",
    "    nn.Linear(H, H), nn.GELU(),\n",
    "    nn.Linear(H, F.n_letters(MOL)),\n",
    ")\n",
    "print(\"参数量\", sum(p.numel() for p in model.parameters()))\n",
    "\n",
    "lossfn = nn.CrossEntropyLoss()\n",
    "opt = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
    "N = xtr.shape[0]\n",
    "hist, best, best_ep = [], 0.0, 0\n",
    "for ep in range(1, 81):\n",
    "    model.train()\n",
    "    perm = torch.randperm(N)\n",
    "    for b in range(0, N, 512):\n",
    "        sel = perm[b:b+512]\n",
    "        loss = lossfn(model(xtr[sel]), ytr[sel])\n",
    "        opt.zero_grad(); loss.backward(); opt.step()\n",
    "    model.eval()\n",
    "    with torch.no_grad():\n",
    "        a_tr = (model(xtr).argmax(-1) == ytr).float().mean().item()\n",
    "        a_va = (model(xva).argmax(-1) == yva).float().mean().item()\n",
    "    if a_va > best:\n",
    "        best, best_ep = a_va, ep\n",
    "    hist.append((ep, a_tr, a_va))\n",
    "\n",
    "print(\"最好 %.1f%%（第 %d 轮）   最后一轮 %.1f%%\" % (100*best, best_ep, 100*hist[-1][2]))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "8a326a10",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 792x484 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "口子 0.9 个百分点     最好 50.2%（第 21 轮）     最后一轮 48.4%\n"
     ]
    }
   ],
   "source": [
    "# 画训练/验证双曲线，中间填色的区域就是「口子」。\n",
    "#\n",
    "# 标题是跟着数据算出来的，不是写死的 —— 因为口子大不一定是过拟合：\n",
    "#   验证集见顶后掉头向下   -> 真过拟合\n",
    "#   口子大但验证集还在涨   -> 还没过拟合，只是训练集跑得快\n",
    "#   验证集在训练集上面     -> 两个集合难度不同（本项目就是这种，第 1 关量过天花板）\n",
    "# 判据永远是「验证集有没有掉头」，不是「口子有多大」。\n",
    "ep, atr, ava = zip(*hist)\n",
    "fig, ax = plt.subplots(figsize=(7.2, 4.4))\n",
    "ax.plot(ep, [100*a for a in atr], label=\"训练集\")\n",
    "ax.plot(ep, [100*a for a in ava], label=\"验证集\")\n",
    "ax.annotate(\"训练集\", (ep[-1], 100*atr[-1]), xytext=(6, 0),\n",
    "            textcoords=\"offset points\", va=\"center\", fontsize=13, color=\"#2a78d6\")\n",
    "ax.annotate(\"验证集\", (ep[-1], 100*ava[-1]), xytext=(6, 0),\n",
    "            textcoords=\"offset points\", va=\"center\", fontsize=13, color=\"#eb6834\")\n",
    "ax.fill_between(ep, [100*a for a in ava], [100*a for a in atr],\n",
    "                color=\"#eb6834\", alpha=.10, lw=0)\n",
    "ax.set_xlabel(\"训练轮数\"); ax.set_ylabel(\"恢复率 %\")\n",
    "gap = 100*(atr[-1]-ava[-1])\n",
    "peak = max(range(len(ava)), key=lambda i: ava[i])\n",
    "if ava[-1] < ava[peak] - 0.5:\n",
    "    title = \"验证集第 %d 轮见顶后往下掉——过拟合了\" % ep[peak]\n",
    "elif gap > 2:\n",
    "    title = \"口子 %.1f 个百分点，但验证集还没掉头\" % gap\n",
    "elif gap < -0.5:\n",
    "    title = \"验证集在训练集上面——两个集合难度不同，不是过拟合\"\n",
    "else:\n",
    "    title = \"两条线贴在一起，还没训练够\"\n",
    "ax.set_title(title)\n",
    "ax.set_xlim(1, ep[-1]*1.12)\n",
    "tidy(ax); plt.show()\n",
    "print(\"口子 %.1f 个百分点     最好 %.1f%%（第 %d 轮）     最后一轮 %.1f%%\"\n",
    "      % (gap, 100*best, best_ep, 100*ava[-1]))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "a9881408",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   宽度       参数量      最好(均±标)      见顶轮       最后一轮\n",
      "   32      1540   49.3±0.2%         29      47.2%\n",
      "   64      5124   49.5±0.3%         52      48.0%\n",
      "  128     18436   50.4±0.4%         42      48.7%\n",
      "  256     69636   50.6±0.3%         37      46.6%\n"
     ]
    }
   ],
   "source": [
    "# 扫隐藏层宽度：32 / 64 / 128 / 256，每个宽度 3 个随机种子。\n",
    "#\n",
    "# 为什么要多个种子：单跑一次的 1 个百分点差异很可能只是初始权重的运气。\n",
    "#   本关实测：单跑 64 得 50.3%，但 3 个种子的均值是 49.5% —— 那 0.8 是运气。\n",
    "# 为什么要同时看两列：「最好」会被挑最大值的偏差抬高，「最后一轮」不会。\n",
    "#   选在两列上都不输给别人的、最小的那个宽度。\n",
    "#\n",
    "# 这一格要跑 12 次训练，比较慢（几分钟）。跑一次记下表就行，不用每次都重跑。\n",
    "def run_width(h, seed, epochs=80):\n",
    "    torch.manual_seed(seed)\n",
    "    m = nn.Sequential(nn.Linear(xtr.shape[1], h), nn.GELU(),\n",
    "                      nn.Linear(h, h), nn.GELU(),\n",
    "                      nn.Linear(h, F.n_letters(MOL)))\n",
    "    opt = torch.optim.Adam(m.parameters(), lr=1e-3)\n",
    "    lf = nn.CrossEntropyLoss(); N = xtr.shape[0]\n",
    "    b_, b_ep, last = 0.0, 0, 0.0\n",
    "    for e in range(1, epochs + 1):\n",
    "        m.train(); perm = torch.randperm(N)\n",
    "        for i in range(0, N, 512):\n",
    "            s = perm[i:i+512]\n",
    "            loss = lf(m(xtr[s]), ytr[s])\n",
    "            opt.zero_grad(); loss.backward(); opt.step()\n",
    "        m.eval()\n",
    "        with torch.no_grad():\n",
    "            last = (m(xva).argmax(-1) == yva).float().mean().item()\n",
    "        if last > b_:\n",
    "            b_, b_ep = last, e\n",
    "    return sum(p.numel() for p in m.parameters()), b_, b_ep, last\n",
    "\n",
    "print(\"%5s %9s %12s %8s %10s\" % (\"宽度\", \"参数量\", \"最好(均±标)\", \"见顶轮\", \"最后一轮\"))\n",
    "for h in (32, 64, 128, 256):\n",
    "    r = [run_width(h, s) for s in (0, 1, 2)]\n",
    "    bb = [x[1] for x in r]\n",
    "    print(\"%5d %9d  %5.1f±%.1f%% %10.0f %9.1f%%\" % (\n",
    "        h, r[0][0], 100*np.mean(bb), 100*np.std(bb),\n",
    "        np.mean([x[2] for x in r]), 100*np.mean([x[3] for x in r])))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "58348bc5",
   "metadata": {},
   "source": [
    "## 部分 4 · 这些百分点是从哪来的\n",
    "\n",
    "训练出一个数不算完。第 1 关立下的规矩：**基准线 + 天花板 + 消融 + 退化检查**，\n",
    "四件事做完才知道这个数是什么意思。\n",
    "\n",
    "这一部分三张表：\n",
    "\n",
    "1. **消融** —— 一次只留一组特征，看谁在挣分\n",
    "2. **天花板** —— 给定这组特征，查表最多能到多少，模型离它还有多远\n",
    "3. **泄漏对照** —— chi 需要碱基环上的原子，而碱基正是要预测的答案。\n",
    "   换一个不需要碱基原子的角做对照，看差多少"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "f1ed92bb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "准备好了。基准线（全猜最常见的碱基）：34.9%\n"
     ]
    }
   ],
   "source": [
    "# 下面三张表都要反复做同一件事：「换一组特征，重新训练一遍，看恢复率」。\n",
    "# 先把这个动作封装成一个函数，免得写四遍，也保证三张表的训练条件完全一致 ——\n",
    "# 同样的 3 层 MLP、同样的 Adam、同样 80 轮、同样的种子。\n",
    "# 唯一的变量是喂进去的特征矩阵，这才叫「一次只改一个变量」。\n",
    "\n",
    "def pad(s, w):\n",
    "    \"\"\"按显示宽度补空格：中文字符占两格，不然表格会歪。\"\"\"\n",
    "    s = str(s)\n",
    "    n = sum(2 if ord(c) > 0x2E80 else 1 for c in s)\n",
    "    return s + \" \" * max(0, w - n)\n",
    "\n",
    "def fit(a, b, seed=0, epochs=80, H=128):\n",
    "    \"\"\"a / b 是训练、验证的特征矩阵。返回 (最好恢复率, 最后一轮, 最好那轮预测用到几类)。\n",
    "\n",
    "    「预测用到几类」是退化检查：如果模型只会输出一种碱基（n=1），\n",
    "    恢复率再高也只是在猜最常见的那个字母，模型什么也没学到。\n",
    "    \"\"\"\n",
    "    torch.manual_seed(seed)\n",
    "    m = nn.Sequential(nn.Linear(a.shape[1], H), nn.GELU(),\n",
    "                      nn.Linear(H, H), nn.GELU(),\n",
    "                      nn.Linear(H, F.n_letters(MOL)))\n",
    "    opt = torch.optim.Adam(m.parameters(), lr=1e-3)\n",
    "    lf = nn.CrossEntropyLoss(); N = a.shape[0]\n",
    "    b_, last, ncls = 0.0, 0.0, 0\n",
    "    for _ in range(epochs):\n",
    "        m.train(); perm = torch.randperm(N)\n",
    "        for i in range(0, N, 512):\n",
    "            s = perm[i:i+512]\n",
    "            loss = lf(m(a[s]), ytr[s])\n",
    "            opt.zero_grad(); loss.backward(); opt.step()\n",
    "        m.eval()\n",
    "        with torch.no_grad():\n",
    "            p = m(b).argmax(-1)\n",
    "            last = (p == yva).float().mean().item()\n",
    "        if last > b_:\n",
    "            b_, ncls = last, int(p.unique().numel())\n",
    "    return b_, last, ncls\n",
    "\n",
    "print(\"准备好了。基准线（全猜最常见的碱基）：%.1f%%\"\n",
    "      % (100 * torch.bincount(yva).max().item() / len(yva)))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "f401ec87",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "特征组合                     维度        最好       最后一轮      用到几类\n",
      "--------------------------------------------------------------\n",
      "仅配对（第 1 关的核心）       1     41.0%      41.0%         2\n",
      "仅 chi                        2     39.9%      38.4%         4\n",
      "仅 eta/theta                  4     37.6%      35.9%         4\n",
      "配对 + chi                    3     46.8%      45.0%         4\n",
      "配对 + eta/theta              5     44.1%      41.3%         4\n",
      "全部 10 维                   10     50.2%      48.4%         4\n",
      "\n",
      "怎么读：拿每一行和「仅配对」比。\n",
      "  加了某组特征只涨零点几个百分点 = 那组和配对高度重合，没有增量。\n",
      "  「用到几类」如果是 1，这一行的恢复率等于基准线，模型是退化的。\n"
     ]
    }
   ],
   "source": [
    "# 表 1 · 消融：一次只留一组特征，看恢复率掉多少。掉得多 = 那组重要。\n",
    "#\n",
    "# 关键在于「删列」而不是「置零」：\n",
    "#   置零会让 cos=0 变成「90°」这个真实取值，模型会当成一个真实的角去学，\n",
    "#   而不是「这里没有信息」。删列才是真的把信息拿掉。\n",
    "#\n",
    "# 列号对照（顺序是 sin sin sin / cos cos cos，不是交替，这里最容易切错）：\n",
    "#   0,1,2 = sin(eta) sin(theta) sin(chi)\n",
    "#   3,4,5 = cos(eta) cos(theta) cos(chi)\n",
    "#   6,7,8 = 10/14/18 Å 邻居数\n",
    "#   9     = 配对\n",
    "GROUPS = {\"eta/theta\": [0, 1, 3, 4], \"chi\": [2, 5],\n",
    "          \"邻居数\": [6, 7, 8], \"配对\": [9]}\n",
    "\n",
    "COMBOS = [\n",
    "    (\"仅配对（第 1 关的核心）\", [\"配对\"]),\n",
    "    (\"仅 chi\",                  [\"chi\"]),\n",
    "    (\"仅 eta/theta\",            [\"eta/theta\"]),\n",
    "    (\"配对 + chi\",              [\"配对\", \"chi\"]),\n",
    "    (\"配对 + eta/theta\",        [\"配对\", \"eta/theta\"]),\n",
    "    (\"全部 10 维\",              [\"配对\", \"chi\", \"eta/theta\", \"邻居数\"]),\n",
    "]\n",
    "\n",
    "print(pad(\"特征组合\", 26) + \"%5s %9s %10s %9s\" % (\"维度\", \"最好\", \"最后一轮\", \"用到几类\"))\n",
    "print(\"-\" * 62)\n",
    "for name, keep in COMBOS:\n",
    "    cols = sorted(sum((GROUPS[g] for g in keep), []))\n",
    "    bb, ll, nc = fit(xtr[:, cols], xva[:, cols])\n",
    "    print(pad(name, 26) + \"%5d %8.1f%% %9.1f%% %9d\" % (len(cols), 100*bb, 100*ll, nc))\n",
    "\n",
    "print()\n",
    "print(\"怎么读：拿每一行和「仅配对」比。\")\n",
    "print(\"  加了某组特征只涨零点几个百分点 = 那组和配对高度重合，没有增量。\")\n",
    "print(\"  「用到几类」如果是 1，这一行的恢复率等于基准线，模型是退化的。\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "043d7039",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "特征                                训练天花板       验证天花板     验证分组数\n",
      "----------------------------------------------------------------\n",
      "仅配对                              36.5%       41.0%         2\n",
      "配对 + chi（anti/syn 二分）         36.5%       41.0%         4\n",
      "配对 + chi（30° 分桶）              37.0%       43.7%        18\n",
      "配对 + chi + 邻居数（粗分桶）       37.4%       43.0%        28\n",
      "\n",
      "模型实际（全部 10 维）：最好 50.2%   最后一轮 48.4%\n",
      "把这两个数和上面最细那一行的验证天花板比，就知道模型是「没学够」还是「特征到顶了」。\n"
     ]
    }
   ],
   "source": [
    "# 表 2 · 天花板：给定一组特征，查表最多能到多少。\n",
    "#\n",
    "# 做法：把残基按特征值分组，每组全部猜这组里最常见的那个碱基。\n",
    "# 模型不可能超过这个数 —— 它拿到的信息就这么多。\n",
    "#\n",
    "# 用处：\n",
    "#   模型离天花板还远  -> 模型没学好（加容量、多训几轮、调学习率）\n",
    "#   模型贴着天花板    -> 特征不够，再怎么调模型也没用，只能加新特征\n",
    "# 第 1 关就是贴着天花板的：训练 36.5/36.4，验证 41.0/41.0。\n",
    "#\n",
    "# 注意分桶的陷阱：桶越细天花板越虚高，极端情况每个残基一个桶 = 100%，\n",
    "# 什么也说明不了。所以要同时看粗桶（anti/syn 二分）和细桶（30°），\n",
    "# 两者差得越多，说明细桶那个数是在背数据。\n",
    "# 这和「模型加宽度就过拟合」是同一件事：加宽 = 自动把空间切成更细的格子。\n",
    "def chi_deg(x):\n",
    "    \"\"\"从 sin/cos 两列还原 chi 角度，映射到 [0,360)。\"\"\"\n",
    "    return torch.rad2deg(torch.atan2(x[:, 2], x[:, 5])) % 360\n",
    "\n",
    "KEYS = {\n",
    "    \"仅配对\":                       lambda x: x[:, 9].long(),\n",
    "    \"配对 + chi（anti/syn 二分）\":  lambda x: x[:, 9].long() * 2 + (x[:, 5] >= 0).long(),\n",
    "    \"配对 + chi（30° 分桶）\":       lambda x: x[:, 9].long() * 12 + (chi_deg(x) // 30).long(),\n",
    "    \"配对 + chi + 邻居数（粗分桶）\": lambda x: (x[:, 9].long() * 24\n",
    "                                               + (x[:, 5] >= 0).long() * 12\n",
    "                                               + (x[:, 7] * 10 // 2).long().clamp(0, 11)),\n",
    "}\n",
    "\n",
    "def ceiling(key, x, y):\n",
    "    k = key(x); hit = 0\n",
    "    for g in k.unique():\n",
    "        hit += torch.bincount(y[k == g], minlength=F.n_letters(MOL)).max().item()\n",
    "    return hit / len(y), int(k.unique().numel())\n",
    "\n",
    "print(pad(\"特征\", 30) + \"%11s %11s %9s\" % (\"训练天花板\", \"验证天花板\", \"验证分组数\"))\n",
    "print(\"-\" * 64)\n",
    "for name, key in KEYS.items():\n",
    "    a, _ = ceiling(key, xtr, ytr)\n",
    "    b, ng = ceiling(key, xva, yva)\n",
    "    print(pad(name, 30) + \"%10.1f%% %10.1f%% %9d\" % (100*a, 100*b, ng))\n",
    "\n",
    "print()\n",
    "print(\"模型实际（全部 10 维）：最好 %.1f%%   最后一轮 %.1f%%\" % (100*best, 100*hist[-1][2]))\n",
    "print(\"把这两个数和上面最细那一行的验证天花板比，就知道模型是「没学够」还是「特征到顶了」。\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "ae024afc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "第三个角                             维度        最好        最后一轮     需碱基原子\n",
      "------------------------------------------------------------------------\n",
      "不要第三个角（配对 + eta/theta）      5     44.1%       41.3%         否\n",
      "无标签赝扭转角 P-C4'-C1'-N            7     43.6%       41.0%         否\n",
      "标准 chi                              7     47.2%       46.0%         是\n",
      "\n",
      "标准 chi 比无标签赝扭转角高 +3.6 个百分点。\n",
      "高出来的部分无法从 gRNAde 的三珠输入里拿到 —— 这是泄漏的上限估计。\n",
      "写进 notes/level2.md 的「没想通的」，第 7 关「和原文差在哪」直接搬过去。\n"
     ]
    }
   ],
   "source": [
    "# 表 3 · 泄漏对照：chi 到底在不在偷看答案。\n",
    "#\n",
    "# 逆向折叠的设定是「给骨架，猜序列」。gRNAde 的输入只有三个珠子：\n",
    "#   P、C4'、N1(嘧啶)/N9(嘌呤)  —— 没有碱基环上的任何原子。\n",
    "# 而标准 chi 的第四个原子是嘌呤 C4 / 嘧啶 C2，就在碱基环上。\n",
    "# prepare_data.py 里 RNA_CHI_C = {\"A\":\"C4\",\"G\":\"C4\",\"C\":\"C2\",\"U\":\"C2\"} ——\n",
    "# 要先知道碱基字母（= 标准答案）才知道该取哪个原子。这是一个二选一的泄漏。\n",
    "#\n",
    "# 对照组：无标签赝扭转角 P - C4' - C1' - 糖苷N。\n",
    "# 这四个原子两种碱基都有、位置等价，不需要知道是嘌呤还是嘧啶。\n",
    "# （这正是本关最初自造、后来被我换掉的那个角 —— 它不能对照文献，但不漏答案。）\n",
    "#\n",
    "# 三行共用同一个底座：eta/theta 的 sin/cos + 配对，只换第三个角。\n",
    "# 如果标准 chi 明显高于无标签版，多出来的那部分八成是泄漏，不是几何。\n",
    "def pseudo_chi(coords):\n",
    "    \"\"\"P - C4' - C1' - 糖苷N 的二面角，拆成 sin/cos。coords 是 [L,4,3]。\"\"\"\n",
    "    d = np.nan_to_num(F._dihedral(coords[:, 0], coords[:, 1], coords[:, 2], coords[:, 3]))\n",
    "    return np.stack([np.sin(d), np.cos(d)], axis=-1).astype(np.float32)\n",
    "\n",
    "BASE = [0, 1, 3, 4, 9]        # eta/theta 的 sin/cos + 配对\n",
    "\n",
    "def build(recs, third):\n",
    "    out = []\n",
    "    for r in recs:\n",
    "        v = F.node_features(r[\"coords\"], MOL, r[\"partner\"], r.get(\"chi\"))\n",
    "        base = v[:, BASE]\n",
    "        if third == \"none\":\n",
    "            out.append(base)\n",
    "        elif third == \"pseudo\":\n",
    "            out.append(np.concatenate([base, pseudo_chi(r[\"coords\"])], axis=-1))\n",
    "        else:\n",
    "            out.append(np.concatenate([base, v[:, [2, 5]]], axis=-1))\n",
    "    return torch.tensor(np.concatenate(out), dtype=torch.float32)\n",
    "\n",
    "ROWS = [(\"none\",   \"不要第三个角（配对 + eta/theta）\", \"否\"),\n",
    "        (\"pseudo\", \"无标签赝扭转角 P-C4'-C1'-N\",       \"否\"),\n",
    "        (\"chi\",    \"标准 chi\",                         \"是\")]\n",
    "\n",
    "print(pad(\"第三个角\", 34) + \"%5s %9s %11s %9s\" % (\"维度\", \"最好\", \"最后一轮\", \"需碱基原子\"))\n",
    "print(\"-\" * 72)\n",
    "res = {}\n",
    "for tag, name, need in ROWS:\n",
    "    a, b = build(tr, tag), build(va, tag)\n",
    "    bb, ll, nc = fit(a, b)\n",
    "    res[tag] = bb\n",
    "    print(pad(name, 34) + \"%5d %8.1f%% %10.1f%% %9s\" % (a.shape[1], 100*bb, 100*ll, need))\n",
    "\n",
    "print()\n",
    "print(\"标准 chi 比无标签赝扭转角高 %+.1f 个百分点。\" % (100*(res[\"chi\"] - res[\"pseudo\"])))\n",
    "print(\"高出来的部分无法从 gRNAde 的三珠输入里拿到 —— 这是泄漏的上限估计。\")\n",
    "print(\"写进 notes/level2.md 的「没想通的」，第 7 关「和原文差在哪」直接搬过去。\")"
   ]
  },
