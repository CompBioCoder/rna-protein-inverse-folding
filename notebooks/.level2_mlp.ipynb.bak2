    "print(\"- 同一次运行的训练集最后一轮：%.1f%%（口子 %+.1f 个百分点）\"\n",
    "      % (100*last_tr, 100*(last_tr - last_va)))\n",
    "if thr:\n",
    "    print(\"- 第 1 关的成绩：%.1f%%（门槛 = %.1f + 1.5 = %.1f%%）\"\n",
    "          % (100*prev, 100*prev, 100*thr))\n",
    "    print(\"- BOSS 是否通过：%s，%+.1f 个百分点\"\n",
    "          % (\"过了\" if best >= thr else \"没过\", 100*(best - thr)))\n",
    "print(\"- 用了几张提示卡：0\")"
   ]
